# ============================================================
# second-brain-starter — .gitignore
#
# The starter ships templates and tooling. Everything that a user
# generates while using their personal vault (or that another agent
# writes into the repo) is ignored so forks stay clean.
# ============================================================

# -- Vault runtime state (user-specific, never shipped) --
_memory/.prompt-log.txt
_memory/.prompt-log-stats.txt
_memory/.needs-end-session
_memory/.compacted-without-end-session
_memory/.consolidation-ready
_memory/.pre-compact-notes.md
_memory/.alerted-*
_memory/.skill-improve/

# -- Automation outputs (regenerated by cron jobs) --
_memory/heartbeat-latest.md
_memory/lint-latest.md
_memory/graph-metrics.md

# -- Session / handoff artifacts (local only) --
HANDOFF.md
SESSION-CHECKPOINT.md

# -- Adapter-generated SSOT files at repo root --
# (Codex / Antigravity write AGENTS.md at vault root.
#  Gemini writes ~/.gemini/GEMINI.md, never here.)
/AGENTS.md

# -- Agent-specific local configs a user may create inside the vault --
.claude/
.cursor/
.gemini/
.codex/
.antigravity/

# -- Cron logs --
.logs/
*.log

# -- Backups from install.sh --
*.bak

# -- OS --
.DS_Store
Thumbs.db
desktop.ini

# -- Editor --
.vscode/
.idea/
*.swp
*.swo
*~

# -- Env / secrets --
.env
.env.*
!.env.example

# -- Node / JS (in case a user adds tooling) --
node_modules/
npm-debug.log
yarn-error.log

# -- Python (in case) --
__pycache__/
*.pyc
.venv/
venv/

# -- Misc --
.cache/
tmp/
