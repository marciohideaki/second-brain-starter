{
  "_doc": "Hook template for ~/.claude/settings.json. install.sh resolves {VAULT} automatically.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash {VAULT}/_bootstrap/global/hooks/on-prompt-submit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash {VAULT}/_bootstrap/global/hooks/on-session-end.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash {VAULT}/_bootstrap/global/hooks/on-pre-compact.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash {VAULT}/_bootstrap/global/hooks/on-notification.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash {VAULT}/_bootstrap/global/hooks/on-post-tool-use.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
